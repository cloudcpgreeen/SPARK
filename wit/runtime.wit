// SPARK 契约 · spark:runtime（约定见 CONTRACT.md）。
// 组件运行时：插件即组件 —— 领域逻辑做成满足此契约的 WASM 组件，宿主沙箱加载并调用。

package spark:runtime@0.1.0;

/// 插件接口：宿主（spark-host）对已加载组件唯一的调用面。
interface plugin {
  /// 插件名（宿主展示 / 日志用），如 "upper"。
  name: func() -> string;
  /// 对输入做一次变换并返回结果。语义由各插件定义；插件可对特定输入触发 trap，
  /// 宿主必须把 trap 当作可恢复错误处理（沙箱隔离）。
  transform: func(input: string) -> string;
}

/// 世界：一个可被宿主实例化的插件组件 = 导出 plugin 接口，不依赖宿主任何能力。
/// 新增插件 = 新增一个导出此世界的组件，宿主零改动即可加载。
world plugin-world {
  export plugin;
}
