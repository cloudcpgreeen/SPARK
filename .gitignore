target/

# cargo-component 构建时重新生成，不入库
spark-plugin*/src/bindings.rs
components/*/src/bindings.rs

# 手动 CLI 暂存目录（已构建的 .wasm），不入库
plugins/

# jco 转译产物：由 build-ui.sh 从 button.wasm 派生，是宿主适配产物，不入库
hosts/web/src/generated/
hosts/*/node_modules/
hosts/*/dist/

# P3 组合产物：由 build-ui.sh 把 mem-store.wasm 组合进 counter-store.wasm 派生而来，
# 是 derived artifact 而非 Component 源，不入库。
dist/
